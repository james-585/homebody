{
  "name": "homebody",
  "version": "0.0.0",
  "private": true,
  "description": "HomeBody home-gym training PWA (dev tooling only; the app has no runtime dependencies)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stamp": "node scripts/stamp-sw.mjs",
    "stamp:check": "node scripts/stamp-sw.mjs --check",
    "verify": "npm run stamp:check && npm run lint && npm run format:check && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10"
  }
}
