  "motion": {
    "dur-press": "100ms",
    "dur-fast": "150ms",
    "dur-base": "200ms",
    "dur-sheet": "280ms",
    "ease-out": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-in": "cubic-bezier(0.4, 0, 1, 1)",
    "ease-standard": "cubic-bezier(0.4, 0, 0.2, 1)",
    "reduced": "no transform, no scale, no overshoot; opacity changes either instant or <= 150ms; no looping animation unless the user starts it"
