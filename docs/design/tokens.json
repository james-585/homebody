    "button-l": { "family": "display", "size": "1.375rem", "px": 22, "weight": 700, "line": 1, "track": "0.1em", "case": "upper" },
    "button-m": { "family": "display", "size": "1.125rem", "px": 18, "weight": 700, "line": 1, "track": "0.08em", "case": "upper" },
    "button-s": { "family": "display", "size": "0.875rem", "px": 14, "weight": 600, "line": 1, "track": "0.08em", "case": "upper" },
    "body-l": { "family": "body", "size": "1rem", "px": 16, "weight": 400, "line": 1.5, "track": "0", "case": "none" },
