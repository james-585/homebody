  "accent": {
    "$description": "One accent is active at a time. accent = fills, rings, current-state lines and accent text; on-accent = label colour on an accent fill. Light theme uses a deeper value of the same hue.",
    "default": "ember",
    "ember": { "dark": { "accent": "#FF5A2C", "on-accent": "#0E0C0A" }, "light": { "accent": "#C2410C", "on-accent": "#FFFFFF" } },
    "amber": { "dark": { "accent": "#E0A15A", "on-accent": "#0E0C0A" }, "light": { "accent": "#93590F", "on-accent": "#FFFFFF" } },
    "green": { "dark": { "accent": "#5DBE8A", "on-accent": "#0E0C0A" }, "light": { "accent": "#2D7A50", "on-accent": "#FFFFFF" } },
    "blue": { "dark": { "accent": "#6AA7FF", "on-accent": "#0E0C0A" }, "light": { "accent": "#2F6BC4", "on-accent": "#FFFFFF" } }
  },
  "font": {
    "display": "'Oswald', 'Arial Narrow', system-ui, sans-serif",
    "body": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": {
    "$description": "size in rem (16px root, scales with user text size); px in brackets for reference. weight, line-height, letter-spacing (em), case. Minimum size for any text is 0.75rem (12px).",
